{
  "manifest_version": 3,
  "name": "Schoology Summarizer Extension",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://saschina.schoology.com/home"],
    "js": ["content.js"]
  }]
}